# ===== API Gateway =====
API_GATEWAY_PORT=3000

# ===== JWT (auth-service ký, api-gateway verify) =====
JWT_SECRET=super_secret_change_me
JWT_EXPIRES_IN=1h

# ===== Redis (microservice transport + cache) =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== PostgreSQL (shared database — tất cả service dùng chung) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wecare
POSTGRES_PASSWORD=wecare_secret
POSTGRES_DB=wecare

# ===== ClickHouse (CDC sink via Debezium + Kafka) =====
CLICKHOUSE_USER=wecare
CLICKHOUSE_PASSWORD=wecare_secret
CLICKHOUSE_DB=wecare_analytics

# ===== Observability: microservice HTTP ports (Prometheus /metrics) =====
AUTH_SERVICE_HTTP_PORT=3001
ORDER_SERVICE_HTTP_PORT=3002

# ===== Logging / Tracking (Pino -> Elasticsearch) =====
LOG_LEVEL=info
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=wecare-logs
# Optional ES auth (leave empty for the dev, security-disabled node)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ===== Grafana =====
GRAFANA_PORT=3030
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
