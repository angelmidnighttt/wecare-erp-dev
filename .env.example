# ===== API Gateway =====
API_GATEWAY_PORT=3000

# ===== JWT (auth-service ký, api-gateway verify) =====
JWT_SECRET=super_secret_change_me
JWT_EXPIRES_IN=1h

# ===== TCP transport (gateway <-> microservices, synchronous calls) =====
# Host: localhost in dev; set to the container name in Docker (see compose).
# Port: defaults to 4001/4002/4003 in code if unset.
AUTH_SERVICE_TCP_HOST=localhost
AUTH_SERVICE_TCP_PORT=4001
ORDER_SERVICE_TCP_HOST=localhost
ORDER_SERVICE_TCP_PORT=4002
PRODUCT_SERVICE_TCP_HOST=localhost
PRODUCT_SERVICE_TCP_PORT=4003

# ===== Redis (cache — reserved for future use) =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== PostgreSQL (shared database — tất cả service dùng chung) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wecare
POSTGRES_PASSWORD=wecare_secret
POSTGRES_DB=wecare

# ===== ClickHouse (CDC sink via Debezium + Kafka) =====
CLICKHOUSE_USER=wecare
CLICKHOUSE_PASSWORD=wecare_secret
CLICKHOUSE_DB=wecare_analytics

# ===== Observability: microservice HTTP ports (Prometheus /metrics) =====
AUTH_SERVICE_HTTP_PORT=3001
ORDER_SERVICE_HTTP_PORT=3002
PRODUCT_SERVICE_HTTP_PORT=3003

# ===== Logging / Tracking (Pino -> Elasticsearch) =====
LOG_LEVEL=info
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=wecare-logs
# Optional ES auth (leave empty for the dev, security-disabled node)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ===== Grafana =====
GRAFANA_PORT=3030
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
